# Cloudflare Pages _headers file
# Prevents browsers and Cloudflare from caching critical JS/SW files
# so updates reach users immediately without needing a hard refresh.

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-cache, no-store, must-revalidate

/app.js
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-cache, no-store, must-revalidate

/pdf-viewer.html
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-cache, no-store, must-revalidate

/manifest.json
  Cache-Control: no-cache, no-store, must-revalidate

/files-index.json
  Cache-Control: public, max-age=0, must-revalidate

/quiz-data.json
  Cache-Control: public, max-age=0, must-revalidate
